# ---------------------------------------------------------------------------
# viper-server
# ---------------------------------------------------------------------------

# "homestead" or "sepolia"
network=homestead
PORT=3001
baseURL=https://viper.folia.app/api
NODE_ENV=production

# Render GIFs on this instance
GENERATE_GIFS=true

# OpenSea, used for metadata refresh (and, until INDEXER_SOURCE=true, owner
# lookups). Get one at https://docs.opensea.io/reference/api-keys
opensea_api=

# ENS reverse lookups
VITE_BOT_API=https://bot.trifle.life


# ---------------------------------------------------------------------------
# RPC
# ---------------------------------------------------------------------------
# Both endpoints previously configured here (eth-trace.rpc.grove.city and
# sepolia.rpc.grove.city) stopped resolving. lib/chain.js therefore ships
# working public defaults, and everything below is optional.
#
# Comma-separated and tried in order. Set these to put your own paid providers
# in front of the public defaults.
#
#   mainnet defaults: https://mainnet.gateway.tenderly.co,
#                     https://eth.drpc.org,
#                     https://ethereum-rpc.publicnode.com
#   sepolia defaults: https://sepolia.gateway.tenderly.co,
#                     https://ethereum-sepolia-rpc.publicnode.com
# RPC_HTTP=

# WebSocket endpoints for the live subscription. ALL of them are subscribed at
# once and duplicate deliveries are deduped, so listing two unrelated providers
# is the cheapest reliability win available.
#
#   mainnet defaults: wss://ethereum-rpc.publicnode.com, wss://eth.drpc.org
#   sepolia defaults: wss://ethereum-sepolia-rpc.publicnode.com,
#                     wss://sepolia.gateway.tenderly.co
# RPC_WSS=

# Legacy single-endpoint vars. Still honoured — they are placed ahead of the
# defaults — but RPC_HTTP is preferred.
# RPC=
# RPC_TEST=


# ---------------------------------------------------------------------------
# Indexer  (see indexer.js)
# ---------------------------------------------------------------------------
# Master switch. Off by default: without this the server behaves exactly as it
# did before the indexer existed, and /v1/state + /v1/stream return 503.
# INDEXER=true

# Make the indexer authoritative for token length and owner lookups, replacing
# the in-memory map fed by Index Supply and removing OpenSea from the metadata
# request path. Requires INDEXER=true.
# INDEXER_SOURCE=true

# Set to false to stop subscribing to Index Supply entirely. Leave unset while
# running both in parallel; set it once INDEXER_SOURCE=true is proven.
# INDEXSUPPLY=false

# Index Supply API key — only needed while the legacy path is still running.
VITE_INDEX_SUPPLY_API=

# Where the log store lives (plain JSON). Defaults to ./data/viper-<network>.json
# INDEXER_DB=

# How often the reconciler sweeps for reorgs and missed logs (ms).
# The sockets are the fast path; this is the safety net.
# INDEXER_RECONCILE_MS=30000

# Blocks per backfill request. Lower it if your provider caps ranges tightly.
# BACKFILL_CHUNK=100000

# Override where the backfill starts. Defaults per chain in lib/chain.js
# (mainnet 17669000, sepolia 3800000).
# START_BLOCK=


# ---------------------------------------------------------------------------
# Rollout
# ---------------------------------------------------------------------------
#   1. INDEXER=true                      index alongside Index Supply, compare
#      node scripts/verify-parity.js --index-supply --all
#   2. INDEXER_SOURCE=true               serve lengths/owners from the indexer
#      node scripts/smoke.js
#   3. INDEXSUPPLY=false                 drop the vendor entirely
